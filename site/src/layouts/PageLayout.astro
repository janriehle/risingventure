---
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  kicker?: string;
  heading: string;
  lede?: string;
}

const { title, description, kicker, heading, lede } = Astro.props;
---

<Layout title={title} description={description}>
  <Nav />

  <header class="page-hero">
    <div class="page-mesh"></div>
    <div class="container">
      {kicker && <span class="page-kicker">// {kicker}</span>}
      <h1>{heading}</h1>
      {lede && <p class="page-lede">{lede}</p>}
    </div>
  </header>

  <main class="page-body">
    <div class="container">
      <slot />
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .container {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 32px;
  }
  .page-hero {
    position: relative;
    padding: 180px 0 90px;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  .page-mesh {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(800px 400px at 20% -10%, rgba(110, 231, 255, 0.18), transparent 60%),
      radial-gradient(700px 350px at 80% 0%, rgba(167, 139, 250, 0.15), transparent 60%),
      radial-gradient(500px 250px at 50% 100%, rgba(240, 171, 252, 0.08), transparent 60%);
    z-index: 0;
    filter: blur(20px);
  }
  .page-hero .container {
    position: relative;
    z-index: 1;
  }
  .page-kicker {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 0.04em;
    display: block;
    margin-bottom: 18px;
  }
  .page-hero h1 {
    font-size: clamp(2.4rem, 5.5vw, 4.2rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.04;
    margin: 0 0 22px;
    max-width: 18ch;
  }
  .page-lede {
    font-size: clamp(16px, 1.4vw, 19px);
    color: var(--fg-muted);
    line-height: 1.55;
    max-width: 60ch;
    margin: 0;
  }
  .page-body {
    padding: 80px 0 140px;
  }
</style>

