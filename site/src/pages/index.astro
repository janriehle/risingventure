---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const fmtShort = (d: Date) => d.toISOString().slice(0, 10); // already UTC ISO

const stats = [
  { value: '35.1%', label: 'Aggregate IRR, US & Canada search funds (Stanford 2024 study)' },
  { value: 'US$ 8–30M', label: 'Target enterprise value range' },
  { value: '4–10 yrs', label: 'Typical search-to-exit horizon' },
];

const pillars = [
  {
    n: '01',
    label: 'Identify',
    title: 'Pattern recognition over deal flow',
    body:
      'A disciplined search across niche service businesses in the Americas — fragmented markets, recurring revenue, owners in transition. We index opportunities the way a model indexes a corpus: by structure, not by source.',
  },
  {
    n: '02',
    label: 'Acquire',
    title: 'One company at a time',
    body:
      'We acquire deliberately — typically one company every three to five years, not several per year — so each receives full operating attention before the next search begins. Transactions are financed in two stages, with investors stepping up alongside the operator. We underwrite resilience first: three-plus years of profitable operations, double-digit margins, a market still expanding.',
  },
  {
    n: '03',
    label: 'Operate',
    title: 'Long-term value compounding',
    body:
      'Hands-on operating leadership over four to ten years. Process rigor, modern digital systems, and select tuck-in acquisitions — turning a sub-scale business into a platform a strategic or financial buyer competes for.',
  },
];
---

<Layout title="RisingVenture — Creating Long-Term Value">
  <Nav />

  <!-- ==================== HERO ==================== -->
  <section class="hero">
    <div class="mesh">
      <div class="mesh-blob mesh-1"></div>
      <div class="mesh-blob mesh-2"></div>
      <div class="mesh-blob mesh-3"></div>
    </div>
    <div class="hero-grid"></div>

    <div class="hero-content">
      <div class="eyebrow">
        <span class="dot"></span>
        <span>Brazil&nbsp;·&nbsp;Search Fund&nbsp;·&nbsp;Est. 2017</span>
      </div>

      <h1 class="headline">
        <span class="line-1">Acquiring <em>enduring businesses.</em></span>
        <span class="line-3 gradient-text">Compounding for decades.</span>
      </h1>

      <p class="lede">
        Rising Venture is a search fund identifying, acquiring, and operating enduring private
        companies in the Americas. Compounding value through hands-on operating leadership,
        AI-native modernization, and patient capital.
      </p>

      <div class="hero-cta">
        <a href="/what" class="btn btn-primary">
          <span>Read the thesis</span>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href="/contact" class="btn btn-ghost">Get in touch</a>
      </div>

      <div class="scroll-cue">
        <span>Scroll</span>
        <span class="scroll-line"></span>
      </div>
    </div>
  </section>

  <!-- ==================== STATS STRIP ==================== -->
  <section class="stats">
    <div class="container">
      <div class="stats-grid">
        {stats.map((s) => (
          <div class="stat">
            <div class="stat-value">{s.value}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== THESIS PILLARS ==================== -->
  <section class="pillars">
    <div class="container">
      <div class="section-head">
        <span class="section-kicker">// approach</span>
        <h2>Three stages, one company, decades of compounding.</h2>
      </div>

      <div class="pillars-grid">
        {pillars.map((p) => (
          <article class="pillar">
            <div class="pillar-meta">
              <span class="pillar-num">{p.n}</span>
              <span class="pillar-label">{p.label}</span>
            </div>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== WRITING ==================== -->
  <section class="writing">
    <div class="container">
      <div class="section-head section-head-row">
        <div>
          <span class="section-kicker">// writing</span>
          <h2>Notes from the search and operating phase.</h2>
        </div>
        <a href="/posts" class="link-arrow">All posts <span>→</span></a>
      </div>

      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a class="post-card" href={`/posts/${post.slug}`}>
              <div class="post-meta">
                <span class="post-date">{fmtShort(post.data.date)}</span>
                {post.data.tag && <span class="post-tag">{post.data.tag}</span>}
              </div>
              <h3 class="post-title">{post.data.title}</h3>
              {post.data.summary && <p class="post-excerpt">{post.data.summary}</p>}
              <span class="post-cta">Read <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Footer />

  <style>
    .container {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 32px;
    }

    /* ==================== HERO ==================== */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 120px 32px 80px;
      overflow: hidden;
    }
    .mesh {
      position: absolute;
      inset: 0;
      z-index: 0;
      filter: blur(80px);
      opacity: 0.55;
    }
    .mesh-blob {
      position: absolute;
      border-radius: 50%;
      mix-blend-mode: screen;
    }
    .mesh-1 {
      width: 60vw;
      height: 60vw;
      background: var(--accent);
      top: -20%;
      left: -10%;
      animation: float-1 22s ease-in-out infinite;
    }
    .mesh-2 {
      width: 50vw;
      height: 50vw;
      background: var(--accent-2);
      top: 10%;
      right: -10%;
      animation: float-2 26s ease-in-out infinite;
    }
    .mesh-3 {
      width: 40vw;
      height: 40vw;
      background: var(--accent-3);
      bottom: -10%;
      left: 30%;
      opacity: 0.6;
      animation: float-3 30s ease-in-out infinite;
    }
    @keyframes float-1 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(8vw, 6vw) scale(1.15); }
    }
    @keyframes float-2 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(-6vw, 8vw) scale(0.9); }
    }
    @keyframes float-3 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(-4vw, -8vw) scale(1.1); }
    }
    .hero-grid {
      position: absolute;
      inset: 0;
      z-index: 1;
      background-image:
        linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
      background-size: 64px 64px;
      mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
    }
    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 900px;
      text-align: center;
    }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 6px 14px;
      border: 1px solid var(--border-strong);
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--fg-muted);
      margin-bottom: 36px;
      background: rgba(255, 255, 255, 0.02);
      backdrop-filter: blur(10px);
    }
    .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 10px var(--accent);
      animation: pulse 2.4s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    .headline {
      font-size: clamp(2.5rem, 6.5vw, 5.5rem);
      font-weight: 500;
      line-height: 1.02;
      letter-spacing: -0.035em;
      margin: 0 0 32px;
      font-family: var(--font-sans);
    }
    .headline .line-1,
    .headline .line-3 {
      display: block;
    }
    .headline em {
      font-family: var(--font-serif);
      font-style: italic;
      font-weight: 400;
      letter-spacing: -0.015em;
    }
    .gradient-text {
      background: linear-gradient(120deg, var(--accent) 0%, var(--accent-2) 55%, var(--accent-3) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
    .lede {
      font-size: clamp(16px, 1.6vw, 19px);
      line-height: 1.55;
      color: #c8ced8;
      max-width: 620px;
      margin: 0 auto 44px;
      text-shadow: 0 1px 24px rgba(6, 8, 13, 0.6);
    }
    .hero-cta {
      display: flex;
      gap: 14px;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 80px;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 13px 22px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 500;
      transition: all 0.25s ease;
      border: 1px solid transparent;
    }
    .btn-primary {
      background: var(--fg);
      color: var(--bg);
    }
    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 10px 40px rgba(231, 234, 240, 0.18);
    }
    .btn-ghost {
      border-color: var(--border-strong);
      color: var(--fg);
    }
    .btn-ghost:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: var(--fg-subtle);
    }
    .scroll-cue {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--fg-subtle);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .scroll-line {
      display: block;
      width: 1px;
      height: 32px;
      background: linear-gradient(to bottom, var(--fg-subtle), transparent);
      animation: scroll-pulse 2s ease-in-out infinite;
    }
    @keyframes scroll-pulse {
      0%, 100% { transform: scaleY(0.4); transform-origin: top; }
      50% { transform: scaleY(1); }
    }

    /* ==================== STATS ==================== */
    .stats {
      padding: 60px 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      background: var(--bg-elevated);
      position: relative;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 48px;
    }
    .stat {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .stat-value {
      font-family: var(--font-sans);
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 500;
      letter-spacing: -0.03em;
      line-height: 1;
      background: linear-gradient(180deg, var(--fg) 0%, var(--fg-muted) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .stat-label {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--fg-muted);
      line-height: 1.5;
      max-width: 32ch;
    }

    /* ==================== SECTION SHELL ==================== */
    .pillars,
    .writing {
      padding: 140px 0;
    }
    .section-head {
      margin-bottom: 64px;
      max-width: 720px;
    }
    .section-head-row {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      max-width: 100%;
      gap: 24px;
      flex-wrap: wrap;
    }
    .section-kicker {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--accent);
      display: block;
      margin-bottom: 16px;
      letter-spacing: 0.04em;
    }
    .section-head h2 {
      font-size: clamp(1.8rem, 3.5vw, 2.6rem);
      font-weight: 500;
      letter-spacing: -0.025em;
      line-height: 1.1;
      margin: 0;
      max-width: 18ch;
    }
    .link-arrow {
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--fg-muted);
      transition: color 0.2s ease;
      white-space: nowrap;
    }
    .link-arrow span {
      display: inline-block;
      transition: transform 0.2s ease;
    }
    .link-arrow:hover {
      color: var(--fg);
    }
    .link-arrow:hover span {
      transform: translateX(4px);
    }

    /* ==================== PILLARS ==================== */
    .pillars-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .pillar {
      padding: 36px;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.025), rgba(255, 255, 255, 0));
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }
    .pillar::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 16px;
      padding: 1px;
      background: linear-gradient(135deg, transparent 30%, var(--accent) 100%);
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .pillar:hover::before {
      opacity: 1;
    }
    .pillar:hover {
      transform: translateY(-2px);
    }
    .pillar-meta {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 24px;
      font-family: var(--font-mono);
      font-size: 12px;
    }
    .pillar-num {
      color: var(--accent);
      letter-spacing: 0.05em;
    }
    .pillar-label {
      color: var(--fg-subtle);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }
    .pillar h3 {
      font-size: 1.25rem;
      font-weight: 500;
      letter-spacing: -0.015em;
      margin: 0 0 16px;
      line-height: 1.3;
    }
    .pillar p {
      color: var(--fg-muted);
      font-size: 14.5px;
      line-height: 1.65;
      margin: 0;
    }

    /* ==================== POSTS ==================== */
    .post-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .post-card {
      display: block;
      padding: 32px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--bg-elevated);
      transition: all 0.3s ease;
      height: 100%;
      position: relative;
      overflow: hidden;
    }
    .post-card::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      width: 200px;
      height: 200px;
      background: radial-gradient(circle, rgba(110, 231, 255, 0.08), transparent 70%);
      transform: translate(50%, -50%);
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .post-card:hover {
      border-color: var(--border-strong);
      transform: translateY(-2px);
    }
    .post-card:hover::after {
      opacity: 1;
    }
    .post-meta {
      display: flex;
      align-items: center;
      gap: 14px;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--fg-muted);
      margin-bottom: 18px;
      letter-spacing: 0.04em;
    }
    .post-tag {
      padding: 3px 9px;
      border: 1px solid var(--border-strong);
      border-radius: 4px;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: 10px;
    }
    .post-title {
      font-size: 1.35rem;
      font-weight: 500;
      letter-spacing: -0.02em;
      line-height: 1.25;
      margin: 0 0 14px;
    }
    .post-excerpt {
      color: var(--fg-muted);
      font-size: 14.5px;
      line-height: 1.6;
      margin: 0 0 20px;
    }
    .post-cta {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--accent);
      letter-spacing: 0.04em;
    }

    /* ==================== RESPONSIVE ==================== */
    @media (max-width: 860px) {
      .stats-grid,
      .pillars-grid,
      .post-list {
        grid-template-columns: 1fr;
        gap: 32px;
      }
      .pillars,
      .writing {
        padding: 100px 0;
      }
    }
  </style>
</Layout>
